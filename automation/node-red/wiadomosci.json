    {
        "id": "logic_msg_robust",
        "type": "function",
        "z": "vultron_grades_flow",
        "name": "Wykryj nowe wiadomości",
        "func": "const nw = msg.data.new_state;\nif (!nw || !nw.attributes || !nw.attributes.wiadomosci) return null;\n\nconst wiadomosci = nw.attributes.wiadomosci;\nconst imie = nw.attributes.student_name || \"Uczeń\";\n\nlet widzianeSygnatury = context.get('seen_signatures') || [];\nlet noweWiadomosci = [];\nlet aktualneSygnatury = [];\n\nwiadomosci.forEach(m => {\n    const sygnatura = `${m.data}_${m.nadawca}_${m.temat}`;\n    aktualneSygnatury.push(sygnatura);\n\n    if (!widzianeSygnatury.includes(sygnatura)) {\n        noweWiadomosci.push({\n            payload: {\n                title: `Nowa wiadomość: ${imie} ✉️`,\n                message: `**Od:** ${m.nadawca}\\n**Temat:** ${m.temat}\\n**Data:** ${m.data}`,\n                notification_id: \"vultron_msg_\" + sygnatura.replace(/[^a-z0-9]/gi, '_').substring(0, 30)\n            }\n        });\n    }\n});\n\ncontext.set('seen_signatures', aktualneSygnatury);\n\nif (widzianeSygnatury.length === 0) {\n    node.warn(\"Pierwsze uruchomienie wiadomości - buforuję listę.\");\n    return null;\n}\n\nif (noweWiadomosci.length > 0) return [noweWiadomosci];\nreturn null;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
