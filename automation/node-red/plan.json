    {
        "id": "e76911c181c26f07",
        "type": "function",
        "z": "vultron_grades_flow",
        "name": "Logika Zmian Planu",
        "func": "const nw = msg.data.new_state;\nconst ow = msg.data.old_state;\n\nif (!nw || !ow || !ow.attributes || !ow.attributes.lekcje) return null;\n\nconst newLekcje = nw.attributes.lekcje || [];\nconst oldLekcje = ow.attributes.lekcje || [];\n\nlet imie = \"Dziecko\";\nconst fn = nw.attributes.friendly_name || \"\";\nif (fn.includes(\": \")) {\n    imie = fn.split(': ').pop();\n}\n\nconst today = new Date().toISOString().split('T')[0];\n\nconst statusMap = {\n    \"ODWOL\": \"ODWOŁANA ❌\",\n    \"ZAST\": \"ZASTĘPSTWO 🔁\",\n    \"PRZEN\": \"PRZENIESIONA 🕒\",\n    \"NIEOB\": \"NIEOBECNI (Wycieczka/Wyjście) 🚌\"\n};\n\nlet alerty = [];\n\nnewLekcje.forEach(n => {\n    if (n.d < today) return;\n    const o = oldLekcje.find(x => x.d === n.d && x.g === n.g && x.p === n.p);\n\n    if (o && n.st !== o.st && n.st !== \"\") {\n        const statusOpis = statusMap[n.st] || n.st;\n        alerty.push(`📅 ${n.d} | ⏰ ${n.g}\\n📖 **${n.p}**\\nStatus: ${statusOpis}`);\n    }\n});\n\nif (alerty.length > 0) {\n    msg.payload = {\n        data: {\n            title: `Zmiana planu: ${imie} 📅`,\n            message: `Wykryto zmiany w harmonogramie:\\n\\n${alerty.join('\\\\n\\\\n')}`,\n            notification_id: \"vultron_plan_alert_\" + nw.entity_id.replace(/\\\\./g, '_')\n        }\n    };\n    return msg;\n}\n\nreturn null;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
