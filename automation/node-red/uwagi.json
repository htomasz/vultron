    {
        "id": "logic_uwagi_robust",
        "type": "function",
        "z": "vultron_grades_flow",
        "name": "Wykryj nowe uwagi",
        "func": "const nw = msg.data.new_state;\nconst ow = msg.data.old_state;\nif (!nw || !nw.attributes || !nw.attributes.uwagi) return null;\n\nconst noweUwagi = nw.attributes.uwagi;\nlet stareUwagi = context.get('uwagi_id_cache') || (ow ? ow.attributes.uwagi : []);\ncontext.set('uwagi_id_cache', noweUwagi);\n\nconst imie = nw.attributes.student_name || \"Uczeń\";\nlet wiadomosci = [];\n\nnoweUwagi.forEach(n => {\n    const juzBylo = stareUwagi.some(o => String(o.id) === String(n.id));\n    if (!juzBylo) {\n        let emoji = (n.typ === 'pozytywna') ? '🌟' : '⚠️';\n        wiadomosci.push({\n            payload: {\n                title: `Nowy wpis w dzienniku: ${imie}`,\n                message: `### ${emoji} ${n.kategoria}\\n**Data:** ${n.data}\\n**Treść:** ${n.tresc}\\n\\n---\\n**Autor:** ${n.autor}`,\n                notification_id: \"vultron_uwaga_\" + n.id\n            }\n        });\n    }\n});\n\nif (wiadomosci.length > 0) return [wiadomosci];\nreturn null;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 360,
        "y": 270,
        "wires": [
            [
                "notify_uwagi_robust"
            ]
        ]
    },
